---
const { title = 'Tim Example Site' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="stylesheet" href="/tim-theme.css" />
  </head>
  <body>
    <nav>
      <a href="./index.html">Home</a>
      <a href="./about.html">About</a>
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      <p>Built with Astro. Edited with Tim.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
  }
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  body {
    font-family: -apple-system, ui-sans-serif, system-ui, sans-serif;
    line-height: 1.65;
    color: #1d1d1f;
    background: #fbfbfd;
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem;
  }
  nav {
    display: flex;
    gap: 1.25rem;
    padding-bottom: 2.5rem;
    font-size: 0.95rem;
  }
  nav a {
    color: #6e6e73;
    text-decoration: none;
  }
  nav a:hover {
    color: #1d1d1f;
  }
  h1 {
    font-size: 2.6rem;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  h2 {
    font-size: 1.4rem;
    letter-spacing: -0.01em;
    margin: 2rem 0 0.5rem;
  }
  p {
    margin-bottom: 1rem;
    color: #424245;
  }
  footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    font-size: 0.85rem;
  }
  footer p {
    color: #86868b;
  }
  @media (max-width: 600px) {
    body { padding: 1.25rem; }
    nav { padding-bottom: 1.5rem; }
    h1 { font-size: 2rem; }
  }
  @media (prefers-color-scheme: dark) {
    body {
      color: #f5f5f7;
      background: #161617;
    }
    nav a { color: #a1a1a6; }
    nav a:hover { color: #f5f5f7; }
    p { color: #d2d2d7; }
    footer { border-top-color: rgba(255, 255, 255, 0.12); }
    footer p { color: #86868b; }
  }
</style>
